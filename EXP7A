
clc;
clear;
close all;

% 5G NR parameters
Nsc = 24;       % Number of subcarriers
Nsym = 14;      % OFDM symbols per slot

% Initialize resource grid
grid = zeros(Nsym, Nsc);

% Downlink assignment: OFDM symbols 1-10
grid(1:10,:) = 1;

% Uplink assignment: OFDM symbols 11-14
grid(11:14,:) = 2;

% Plot resource grid
figure;

imagesc(grid);

grid on;

xlabel('Subcarrier Index');
ylabel('OFDM Symbol Index');

title('Simplified 5G NR Time-Frequency Resource Grid');

colorbar;

% Set color labels
colormap([1 1 1; 0 0.45 0.85; 0.9 0.3 0.2]);

clim([0 2]);
