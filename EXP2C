
clear;
clc;
close all;

% System parameters
studyAreaKm2 = 4.0;
userDensityPerKm2 = 30;
maxUsersPerCell = 50;

% Different cell radii
cellRadiiKm = [1.00, 0.75, 0.50];

% Calculate total user demand
totalDemand = studyAreaKm2 * userDensityPerKm2;

% Calculate hexagonal cell area
cellAreaKm2 = (3 * sqrt(3) / 2) .* cellRadiiKm.^2;

% Estimate number of cells
estimatedCells = ceil(studyAreaKm2 ./ cellAreaKm2);

% Calculate network capacity
networkCapacity = estimatedCells .* maxUsersPerCell;

% Calculate number of users served
usersServed = min(totalDemand, networkCapacity);

% Create comparison table
results = table(cellRadiiKm', estimatedCells', ...
    networkCapacity', usersServed', ...
    'VariableNames', {'CellRadius_km', ...
    'EstimatedNumberOfCells', ...
    'EstimatedNetworkCapacity', ...
    'EstimatedUsersServed'});

% Display results
disp('Estimated user capacity:');
disp(results);

% Plot network capacity and users served
figure;

bar(cellRadiiKm, ...
    [networkCapacity' usersServed'], 'grouped');

hold on;

yline(totalDemand, '--r', 'Total user demand');

xlabel('Cell radius (km)');
ylabel('Number of users');

title('Cell Size and Estimated User Capacity');

legend('Network capacity', 'Users served', ...
    'Total demand', 'Location', 'northwest');

grid on;
hold off;
